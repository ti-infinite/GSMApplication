{
  "name": "gsmapplications-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "orval",
    "build": "tsc -b && vite build",
    "prebuild": "orval",
    "preview": "vite preview",
    "lint": "eslint",
    "generate": "orval",
    "swagger:refresh": "curl -k https://localhost:8081/swagger/v1/swagger.json -o swagger/gsm-auth.json && curl -k https://localhost:8082/swagger/v1/swagger.json -o swagger/gsm-application.json && curl -k https://localhost:8083/swagger/v1/swagger.json -o swagger/gsm-operations.json",
    "api:sync": "npm run swagger:refresh && npm run generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-collapsible": "^1.1.21",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.3.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "i18next": "^24.2.3",
    "idb": "^8.0.3",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.5.2",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.6.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9",
    "orval": "^8.13.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6.3.5"
  },
  "allowScripts": {
    "esbuild@0.28.0": true,
    "esbuild@0.25.12": true
  }
}
