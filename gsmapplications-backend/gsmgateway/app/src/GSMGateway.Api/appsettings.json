{
  "JwtSettings": {
    "Issuer": "GSMAuth",
    "Audience": "GSMClients",
    "SecretKey": "gsm-auth-secret-key-change-in-production-2026"
  },

  "ReverseProxy": {
    "Routes": {

      // ✅ AUTH (sin seguridad porque es login)
      "gsmAuthApi": {
        "ClusterId": "gsmAuthCluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/security/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/security" },
          { "PathPrefix": "/api" }
        ]
      },

      // ✅ AUTH SWAGGER
      "gsmAuthSwaggerJson": {
        "ClusterId": "gsmAuthCluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/swagger/security/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/swagger/security" },
          { "PathPrefix": "/swagger" }
        ]
      },

      // ✅ APPLICATION (PROTEGIDO con JWT)
      "gsmApplicationApi": {
        "ClusterId": "gsmApplicationCluster",
        "AuthorizationPolicy": "AuthenticatedUser",
        "Match": {
          "Path": "/api/application/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/application" },
          { "PathPrefix": "/api" }
        ]
      },

      // ✅ APPLICATION SWAGGER
      "gsmApplicationSwaggerJson": {
        "ClusterId": "gsmApplicationCluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/swagger/application/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/swagger/application" },
          { "PathPrefix": "/swagger" }
        ]
      }
    },

    "Clusters": {

      // ✅ AUTH SERVICE
      "gsmAuthCluster": {
        "Destinations": {
          "authDestination": {
            "Address": "https://172.17.0.1:8081/"
          }
        }
      },

      // ✅ APPLICATION SERVICE
      "gsmApplicationCluster": {
        "Destinations": {
          "applicationDestination": {
            "Address": "https://172.17.0.1:8082/"
          }
        }
      }
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  }
}